NEXT_PUBLIC_APP_URL="http://localhost:3000"
DATABASE_URL=""
AES_SECRET_KEY=""   #node ./crypto.js
#OAUTH VARIABLES
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
#MAIL VARIABLES
MAIL_HOST=""
MAIL_PORT=
MAIL_AUTH_USER=""
MAIL_AUTH_PASSWORD=""
# Générer une clé privée (2048 bits)
#openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048

# Extraire la clé publique
#openssl rsa -pubout -in private.pem -out public.pem
RSA_PRIVATE_KEY=""
RSA_PUBLIC_KEY=""
# STOCKAGE DES FICHIERS (Cloudflare R2) — obligatoire en production sur Vercel.
# Sans ces variables, les fichiers sont écrits dans public/uploads/ (développement local uniquement).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Paiement en ligne i-pay (https://docs.i-pay.money)
IPAY_SECRET_KEY=            # clé secrète du compte (sandbox ou live)
IPAY_ENV=sandbox            # sandbox | live
IPAY_WEBHOOK_SECRET=        # secret partagé du webhook (en-tête Secret-Hash)
CRON_SECRET=                # protège /api/cron/ipay-reconcile

# Emails via Resend (https://resend.com) — remplacent MAIL_HOST/MAIL_PORT/MAIL_AUTH_*
RESEND_API_KEY=
MAIL_FROM="JNJL <no-reply@jnjl.ne>"
CONTACT_EMAIL=

# ScanHub : QR des badges et pointage à l'entrée
SCANHUB_URL=                 # ex. https://scan-hub.vercel.app
SCANHUB_API_KEY=             # clé API de l'espace JNJL (en-tête x-api-key)
SCANHUB_WEBHOOK_SECRET=      # secret whsec_… du webhook ScanHub → /api/webhooks/scanhub
SCANHUB_EVENT_ID=            # (optionnel) événement ScanHub auquel rattacher les badges
SCANHUB_CHECKER_USER_ID=     # (optionnel) compte JNJL qui signe les pointages ; défaut : premier Super Admin
LOGIN_ALERT_EMAILS=false     # true = e-mail "Nouvelle connexion" à chaque connexion depuis une nouvelle adresse (consomme le quota Resend)

# Seed (prisma/seed.ts) : mots de passe fournis ici, jamais dans le code
SEED_SUPERADMIN_PASSWORD=     # 12 caractères minimum
SEED_TEST_PASSWORD=           # 12 caractères minimum (comptes de test, si activés)
